{
  "name": "dsh-llm-huawei-codeagent",
  "version": "0.1.3",
  "description": "Huawei CodeAgent/CodeMate LLM provider for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengengjian/dsh-llm-huawei-codeagent.git"
  },
  "bugs": {
    "url": "https://github.com/chengengjian/dsh-llm-huawei-codeagent/issues"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "eventsource-parser": "^3.1.0",
    "undici": "7.28.0"
  }
}
